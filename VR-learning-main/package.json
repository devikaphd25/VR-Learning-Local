{
  "name": "vrclass-integrated",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev up --foreground",
    "dev:runtime": "vite",
    "dev:server": "node --env-file=.env.server --import tsx server.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "build": "vite build",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "@preact/signals-core": "^1.14.3",
    "@supabase/supabase-js": "^2.109.0",
    "concurrently": "^9.2.3",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "npm:super-three@0.181.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@iwsdk/cli": "0.4.2",
    "@iwsdk/reference": "0.4.2",
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@iwsdk/vite-plugin-uikitml": "0.4.2",
    "@meta-quest/hzdb": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/three": "*",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.9",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
