<style>
  .score-panel {
    align-items: flex-start;
    padding: 2;
    width: 44;
    height: 20;
    background-color: #f5f0e6;
    border-color: #7a1f2b;
    border-width: 0.2;
    border-radius: 2;
    display: flex;
    flex-direction: column;
  }

  .score-heading {
    font-size: 2.6;
    font-weight: bold;
    color: #7a1f2b;
    text-align: left;
  }

  .score-line {
