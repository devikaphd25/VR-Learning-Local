<style>
  .notification-root {
    width: 780;
    height: 104;
    flex-direction: row;
    align-items: center;
    padding: 14px;
    border-radius: 20px;
    background-color: rgba(5, 13, 29, 0.96);
    border-width: 2;
    border-color: rgba(251, 191, 36, 0.6);
    gap: 16px;
    pointer-events: auto;
    pointer-events-order: 60000;
  }

  .notification-input-disabled {
    pointer-events: none;
  }

  .notification-header {
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .notification-icon {
    font-size: 30px;
  }

  .notification-title {
    font-size: 17px;
    font-weight: bold;
    color: white;
  }

  .notification-student-name {
    width: 540;
    font-size: 21px;
    color: #fbbf24;
    font-weight: 600;
    white-space: nowrap;
  }

  .notification-message {
    display: none;
    font-size: 14px;
    color: rgba(255,255,255,0.92);
  }

  .notification-seat {
    display: none;
    font-size: 13px;
    color: rgba(148,163,184,1);
  }

  .button-row {
    flex-direction: row;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 0;
    margin-left: auto;
  }

  .btn {
    width: 190;
    height: 70;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
    font-size: 19px;
    font-weight: bold;
    cursor: pointer;
    pointer-events: auto;
    pointer-events-order: 60001;
  }

  .btn-unmute {
    background-color: rgba(34,197,94,0.95);
    color: white;
  }

  .btn-cancel {
    background-color: rgba(239,68,68,0.95);
    color: white;
  }
</style>

<Panel id="raise-hand-notification-root" class="notification-root">
  <Panel style="flex-direction: row; align-items: center; width: 540px;">
    <Panel class="notification-header">
        <Text id="notification-icon" class="notification-icon"></Text>
        <Text id="notification-title" class="notification-title">Raise Hand</Text>
    </Panel>

    <!-- ✅ IMPORTANT: These IDs must match exactly -->
    <Text id="notification-student-name" class="notification-student-name">
        Student Name
    </Text>

    <Text id="notification-message" class="notification-message">
        raised their hand
    </Text>

    <Text id="notification-seat" class="notification-seat">
        Seat: --
    </Text>
  </Panel>

    <Panel id="notification-buttons" class="button-row">
        <Button id="notification-unmute" class="btn btn-unmute">
            ✋ Lower Hand
        </Button>
    </Panel>

</Panel>
