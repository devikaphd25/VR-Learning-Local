<style>
  .controls {
    width: 1120;
    height: 104;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 12;
    padding: 16;
    background-color: rgba(5, 13, 29, 0.94);
    border-width: 2;
    border-color: rgba(103, 232, 249, 0.72);
    border-radius: 24;
    pointer-events: auto;
  }
  .control-button {
    width: 160;
    height: 70;
    align-items: center;
    justify-content: center;
    border-radius: 16;
    border-width: 2;
    color: #ffffff;
    font-size: 18;
    font-weight: 700;
    font-family: inter;
    cursor: pointer;
    pointer-events: auto;
  }
  .play { background-color: rgba(8, 145, 178, 0.78); border-color: #67e8f9; }
  .play:hover { background-color: rgba(6, 182, 212, 0.92); }
  .seek { background-color: rgba(30, 64, 175, 0.82); border-color: #93c5fd; }
  .seek:hover { background-color: rgba(37, 99, 235, 0.94); }
  .restart { background-color: rgba(91, 33, 182, 0.82); border-color: #c4b5fd; }
  .marker { background-color: rgba(161, 98, 7, 0.9); border-color: #fde047; }
  .marker:hover { background-color: rgba(202, 138, 4, 0.96); }
  .clear { background-color: rgba(71, 85, 105, 0.9); border-color: #cbd5e1; }
  .return { width: 200; background-color: rgba(153, 27, 27, 0.82); border-color: #fca5a5; }
  .return:hover { background-color: rgba(220, 38, 38, 0.9); }
  .video-timer {
    width: 170;
    height: 70;
    align-items: center;
    justify-content: center;
    border-radius: 16;
    border-width: 2;
    border-color: rgba(103, 232, 249, 0.72);
    background-color: rgba(8, 47, 73, 0.9);
    color: #a5f3fc;
    font-size: 18;
    font-weight: 700;
    font-family: inter;
    text-align: center;
  }
</style>

<div id="presentation-controls-root" class="controls">
  <text id="video-timer" class="video-timer">00:00 / --:--</text>
  <button id="video-back-10" class="control-button seek">-10 SEC</button>
  <button id="video-play-pause" class="control-button play">PLAY</button>
  <button id="video-forward-10" class="control-button seek">+10 SEC</button>
  <button id="video-restart" class="control-button restart">RESTART</button>
  <button id="briefing-highlight" class="control-button marker">MARKER OFF</button>
  <button id="briefing-highlight-clear" class="control-button clear">CLEAR</button>
  <button id="video-return-class" class="control-button return">RETURN TO CLASS</button>
</div>
